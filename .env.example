# ============================================================
# MovieFlix — variáveis de ambiente
# Copie para .env e preencha. NUNCA commite o .env real.
# ============================================================

# --- Frontend (Vite) ---
# Chave PÚBLICA do StreamBetter (plano Creator, sb_pk_*). Usada no EMBED
# OFICIAL que roda no navegador. NÃO é segredo. O domínio do site
# (ex.: movieflix-bszf.onrender.com) precisa estar cadastrado na conta
# Creator do StreamBetter para o embed validar.
VITE_STREAMBETTER_PUBLIC_KEY=sb_pk_19fe7c75a49585cd84ced96806703a2176768fa4f77a7ea4

# URL do backend (usada pelo frontend para chamadas /api/* quando o site é
# publicado como Static Site separado do backend).
# VITE_API_URL=https://movieflix-api-udsv.onrender.com

# ============================================================
# Backend (Express) — variáveis de servidor (NUNCA no bundle do frontend)
# ============================================================

# Chave da TMDb (usada no proxy /api/tmdb). Pode ser TMDB_API_KEY ou
# VITE_TMDB_TOKEN.
TMDB_API_KEY=

# Supabase
SUPABASE_URL=https://mntyanfhxiqspdedmddb.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ============================================================
# ASSINATURA — ATIVAÇÃO MANUAL VIA WHATSAPP
# ============================================================
# O MovieFlix NÃO usa mais pagamento automático (Mercado Pago). A ativação é
# feita manualmente pelo admin: o cliente contrata pelo WhatsApp
# (https://wa.me/11943750307) e o admin ativa a conta informando SOMENTE
# e-mail + plano, via a função SQL `activate_subscription_by_email`
# (SECURITY DEFINER, só admin) no Supabase.
#
# NENHUMA variável de Mercado Pago é necessária no fluxo atual. As edge
# functions mercadopago-pay / mercadopago-webhook ficam desativadas/isoladas
# e não são chamadas pelo app.

# Porta do backend
PORT=5000