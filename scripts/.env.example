# MovieFlix Auto-Importer - Configurações

# TMDB API Key → https://www.themoviedb.org/settings/api
TMDB_API_KEY=sua_chave_aqui

# Bunny Stream → https://bunny.net/stream/
# Access Key: Bunny.net → Stream → API → Access Key
# Library ID: Bunny.net → Stream → sua biblioteca → ID
BUNNY_API_KEY=sua_chave_aqui
BUNNY_LIBRARY_ID=seu_library_id_aqui

# Supabase → Painel do Supabase → Settings → API
# Use a SERVICE ROLE KEY (não a anon key!)
SUPABASE_URL=https://seuprojeto.supabase.co
SUPABASE_SERVICE_KEY=sua_service_role_key_aqui
