<?xml version="1.0" encoding="utf-8"?>
<!-- Tecla do teclado em tela.
     Em foco: preenchimento violeta + anel branco — visível a 3 metros. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/mf_purple" />
            <corners android:radius="9dp" />
            <stroke android:width="2dp" android:color="@color/mf_white" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/mf_surface_strong" />
            <corners android:radius="9dp" />
            <stroke android:width="1dp" android:color="#33FFFFFF" />
        </shape>
    </item>
</selector>
