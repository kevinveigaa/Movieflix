<?xml version="1.0" encoding="utf-8"?>
<!-- Botão fantasma: superfície escura.
     Em foco: contorno violeta. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/mf_surface_strong" />
            <corners android:radius="@dimen/pill_radius" />
            <stroke android:width="3dp" android:color="@color/mf_purple" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/mf_surface_light" />
            <corners android:radius="@dimen/pill_radius" />
        </shape>
    </item>
</selector>
