<?xml version="1.0" encoding="utf-8"?>
<!--
  Botão FAVORITOS no estado "JÁ ESTÁ NOS FAVORITOS".

  Dá retorno visual inequívoco a distância: contorno dourado (o mesmo tom da
  nota ★) sobre a superfície escura. O rótulo muda para "♥ Remover dos
  Favoritos" e o texto fica dourado — o usuário vê o estado sem precisar
  reabrir a tela.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/mf_surface_strong" />
            <corners android:radius="12dp" />
            <stroke
                android:width="3dp"
                android:color="@color/mf_gold" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/mf_surface_light" />
            <corners android:radius="12dp" />
            <stroke
                android:width="2dp"
                android:color="@color/mf_gold" />
        </shape>
    </item>
</selector>
