<?xml version="1.0" encoding="utf-8"?>
<!-- Botão secundário: transparente com contorno cinza.
     Em foco: contorno branco + leve fundo (mesmo peso visual do primário). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#26FFFFFF" />
            <corners android:radius="@dimen/pill_radius" />
            <stroke android:width="3dp" android:color="@color/mf_white" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#14000000" />
            <corners android:radius="@dimen/pill_radius" />
            <stroke android:width="1dp" android:color="@color/mf_border" />
        </shape>
    </item>
</selector>
