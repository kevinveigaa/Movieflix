<?xml version="1.0" encoding="utf-8"?>
<!--
  Anel de foco do card: moldura com o gradiente de marca (violeta→índigo)
  desenhada por cima do poster. O miolo é transparente, então a arte do
  filme continua visível — só a moldura acende no D-pad.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      Anel de foco do card: moldura FINA (3dp) com o gradiente de marca.
      O miolo é totalmente transparente, então a CAPA continua 100% visível —
      o foco é indicado por borda + glow (elevation) + leve zoom, nunca por uma
      camada roxa opaca sobre a arte.
    -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="@color/mf_magenta"
                android:endColor="@color/mf_purple" />
            <corners android:radius="@dimen/card_radius" />
        </shape>
    </item>
    <item
        android:bottom="3dp"
        android:left="3dp"
        android:right="3dp"
        android:top="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</layer-list>
