<?xml version="1.0" encoding="utf-8"?>
<!--
  Anel de foco do card: moldura com o gradiente de marca (violeta→índigo)
  desenhada por cima do poster. O miolo é transparente, então a arte do
  filme continua visível — só a moldura acende no D-pad.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="@color/mf_indigo"
                android:endColor="@color/mf_purple" />
            <corners android:radius="@dimen/card_radius" />
        </shape>
    </item>
    <item
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <corners android:radius="9dp" />
        </shape>
    </item>
</layer-list>
