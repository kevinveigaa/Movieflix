<?xml version="1.0" encoding="utf-8"?>
<!--
  ANEL DE FOCO do card (correção pedida pelo dono).

  Antes o foco escurecia/tingia o poster e a capa "sumia". Agora o destaque é
  ESTRUTURAL:
    - uma MOLDURA em gradiente magenta→violeta (4dp) nas bordas;
    - um fio branco interno de 1dp para contraste a distância;
    - miolo 100% TRANSPARENTE → a arte do filme continua totalmente visível.

  O glow/sombra vem da elevação + do leve zoom aplicados na view do card.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Moldura em gradiente de marca -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="@color/mf_red"
                android:endColor="@color/mf_purple" />
            <corners android:radius="@dimen/card_radius" />
        </shape>
    </item>
    <!-- Fio branco interno (contraste) -->
    <item
        android:bottom="3dp"
        android:left="3dp"
        android:right="3dp"
        android:top="3dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#99FFFFFF" />
            <solid android:color="#00000000" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <!-- Miolo TRANSPARENTE: a capa permanece 100% visível -->
    <item
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <corners android:radius="7dp" />
        </shape>
    </item>
</layer-list>
