<?xml version="1.0" encoding="utf-8"?>
<!-- Superfície de linha focável (listas/resultados).
     Em foco: fundo elevado + contorno violeta. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/mf_surface_strong" />
            <corners android:radius="12dp" />
            <stroke android:width="3dp" android:color="@color/mf_purple" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0FFFFFFF" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
