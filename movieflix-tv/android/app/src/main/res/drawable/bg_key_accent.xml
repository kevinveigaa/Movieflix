<?xml version="1.0" encoding="utf-8"?>
<!-- Tecla de CONFIRMAÇÃO do teclado em tela (ENTRAR / BUSCAR / SALVAR).
     Gradiente de marca; em foco, anel branco. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="@color/mf_indigo"
                android:centerColor="@color/mf_purple"
                android:endColor="@color/mf_purple_light" />
            <corners android:radius="9dp" />
            <stroke android:width="2dp" android:color="@color/mf_white" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="@color/mf_violet_deep"
                android:endColor="@color/mf_purple" />
            <corners android:radius="9dp" />
        </shape>
    </item>
</selector>
