<?xml version="1.0" encoding="utf-8"?>
<!--
  Fundo do poster quando a capa ainda não chegou (ou não existe).

  Antes era uma cor chapada clara, que aparecia como um bloco rosa/vazio e
  parecia falha de carregamento. Agora é uma superfície escura da marca: se a
  imagem não vier, o card mostra a inicial do título (ver CardPresenter) sobre
  um fundo discreto, e isso lê como decisão de design — não como erro.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/mf_surface_strong" />
    <corners android:radius="@dimen/card_radius" />
</shape>