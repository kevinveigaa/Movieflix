<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="@color/mf_red"
                android:endColor="@color/mf_red_light" />
            <corners android:radius="12dp" />
            <stroke
                android:width="3dp"
                android:color="@color/mf_white" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="@color/mf_red"
                android:endColor="@color/mf_red_light" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>