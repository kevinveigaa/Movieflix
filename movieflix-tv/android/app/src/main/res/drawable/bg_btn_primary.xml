<?xml version="1.0" encoding="utf-8"?>
<!--
  Botão de ação PRINCIPAL (ASSISTIR).

  Correção: o estado de foco usava preenchimento BRANCO, o que apagava o
  gradiente da marca e dava um aspecto de retângulo genérico. Agora o foco
  MANTÉM a identidade (gradiente da marca) e sinaliza a seleção com um anel
  branco grosso + gradiente mais luminoso — legível a 3 metros sem esconder
  a cor do botão.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="@color/mf_red_light"
                android:endColor="@color/mf_purple_light" />
            <corners android:radius="12dp" />
            <stroke
                android:width="3dp"
                android:color="@color/mf_white" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="@color/mf_red"
                android:endColor="@color/mf_purple" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>