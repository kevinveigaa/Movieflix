<?xml version="1.0" encoding="utf-8"?>
<!--
  Campo EM EDIÇÃO no teclado em tela (login: E-MAIL/SENHA · busca).

  Por que existe: o foco do D-pad vive nas TECLAS do teclado, então o contorno de
  `state_focused` de bg_input não aparece enquanto se digita. Este drawable marca
  o campo que está REALMENTE recebendo o que o teclado escreve, e continua marcado
  durante todo o preenchimento — o usuário vê de longe em qual campo está.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/mf_surface_strong" />
    <corners android:radius="12dp" />
    <stroke android:width="3dp" android:color="@color/mf_purple" />
</shape>
