<?xml version="1.0" encoding="utf-8"?>
<!-- Sombra inferior do card (garante legibilidade dos ícones sobre o poster). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!--
      Scrim SUTIL do rodapé do card: existe apenas para os ícones de play e
      favorito ficarem legíveis. O topo (onde fica a arte) permanece 100%
      visível — antes o degradê era forte e comia boa parte da capa.
    -->
    <gradient
        android:angle="90"
        android:startColor="#9905050A"
        android:centerColor="#1A05050A"
        android:endColor="#0005050A" />
</shape>
