<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mf_black"
    android:orientation="vertical"
    android:padding="48dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Quem está assistindo?"
        android:textColor="@color/mf_white"
        android:textSize="34sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/lblPerfisInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text=""
        android:textColor="@color/mf_gray"
        android:textSize="16sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/listaPerfis"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnNovoPerfil"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:backgroundTint="@color/mf_purple"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:text="+ NOVO PERFIL"
            android:textColor="@color/mf_white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnContinuar"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_marginStart="14dp"
            android:backgroundTint="@color/mf_red"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:text="CONTINUAR"
            android:textColor="@color/mf_white"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
