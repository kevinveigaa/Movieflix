<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mf_black"
    android:orientation="vertical"
    android:padding="48dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Assinatura e Planos"
        android:textColor="@color/mf_white"
        android:textSize="34sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/lblPlanoAtual"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text=""
        android:textColor="@color/mf_white"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/lblPlanoStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text=""
        android:textColor="@color/mf_gray"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/lblPlanoLimites"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text=""
        android:textColor="@color/mf_purple_light"
        android:textSize="15sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="12dp">

        <LinearLayout
            android:id="@+id/containerPlanos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnGerenciarPerfis"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:backgroundTint="@color/mf_purple"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:text="GERENCIAR PERFIS"
            android:textColor="@color/mf_white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnVoltarConta"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_marginStart="14dp"
            android:backgroundTint="@color/mf_red"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:text="VOLTAR"
            android:textColor="@color/mf_white"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
