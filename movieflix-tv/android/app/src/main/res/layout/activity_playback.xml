<?xml version="1.0" encoding="utf-8"?>
<!--
  Player de TV: vídeo em tela cheia + overlay de controles acionado pelo
  controle remoto (OK mostra/esconde). Sem toque, sem navegador.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mf_black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:show_buffering="never"
        app:use_controller="false" />

    <!-- Fallback híbrido: WebView do embed oficial (StreamBetter) usado SOMENTE
         quando o player nativo (ExoPlayer) não consegue resolver a fonte.
         O embed é o MESMO que o site/mobile usam (mesma conta, mesmos dados). -->
    <WebView
        android:id="@+id/webViewPlayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Overlay de controles (escondido até o OK) -->
    <FrameLayout
        android:id="@+id/overlayControles"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#9905050A" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="@drawable/hero_scrim_bottom"
            android:orientation="vertical"
            android:paddingStart="46dp"
            android:paddingTop="30dp"
            android:paddingEnd="46dp"
            android:paddingBottom="26dp">

            <TextView
                android:id="@+id/lblTituloPlayer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/bebas_neue"
                android:letterSpacing="0.02"
                android:text=""
                android:textColor="@color/mf_white"
                android:textSize="40sp" />

            <TextView
                android:id="@+id/lblMetaPlayer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text=""
                android:textColor="@color/mf_gray_light"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnRetroceder"
                android:layout_width="wrap_content"
                android:layout_height="62dp"
                android:background="@drawable/bg_pill_ghost"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:minWidth="150dp"
                android:text="\u23EA  15s"
                android:textColor="@color/mf_white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnPlayPause"
                android:layout_width="wrap_content"
                android:layout_height="62dp"
                android:layout_marginStart="18dp"
                android:background="@drawable/bg_pill_primary"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:minWidth="180dp"
                android:text="\u23F8  Pausar"
                android:textColor="@color/mf_white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnAvancar"
                android:layout_width="wrap_content"
                android:layout_height="62dp"
                android:layout_marginStart="18dp"
                android:background="@drawable/bg_pill_ghost"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:minWidth="150dp"
                android:text="15s  \u23E9"
                android:textColor="@color/mf_white"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/hero_scrim_bottom"
            android:orientation="vertical"
            android:paddingStart="46dp"
            android:paddingTop="18dp"
            android:paddingEnd="46dp"
            android:paddingBottom="30dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="7dp"
                android:orientation="horizontal">

                <View
                    android:id="@+id/progressFill"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0"
                    android:background="@drawable/progress_fill" />

                <View
                    android:id="@+id/progressRest"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/progress_track" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/lblTempos"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text=""
                    android:textColor="@color/mf_gray_light"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/lblEpAnterior"
                    android:layout_width="wrap_content"
                    android:layout_height="54dp"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/bg_pill_ghost"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center"
                    android:paddingStart="26dp"
                    android:paddingEnd="26dp"
                    android:text="Epis\u00f3dio anterior"
                    android:textColor="@color/mf_white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/lblProximoEp"
                    android:layout_width="wrap_content"
                    android:layout_height="54dp"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/bg_pill_secondary"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center"
                    android:paddingStart="26dp"
                    android:paddingEnd="26dp"
                    android:text="Próximo episódio"
                    android:textColor="@color/mf_white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/btnSairPlayer"
                    android:layout_width="wrap_content"
                    android:layout_height="54dp"
                    android:background="@drawable/bg_pill_ghost"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center"
                    android:paddingStart="26dp"
                    android:paddingEnd="26dp"
                    android:text="Sair"
                    android:textColor="@color/mf_white"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Carregando -->
    <LinearLayout
        android:id="@+id/layoutLoading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/mf_black"
        android:gravity="center"
        android:orientation="vertical">

        <ProgressBar
            android:id="@+id/progresso"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:indeterminateTint="@color/mf_purple" />

        <TextView
            android:id="@+id/lblCarregando"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Preparando o vídeo…"
            android:textColor="@color/mf_gray"
            android:textSize="17sp" />
    </LinearLayout>

    <!-- Erro -->
    <LinearLayout
        android:id="@+id/layoutErro"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/mf_black"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="48dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge"
            android:gravity="center"
            android:paddingStart="26dp"
            android:paddingTop="10dp"
            android:paddingEnd="26dp"
            android:paddingBottom="10dp"
            android:text="Não foi possível reproduzir"
            android:textColor="@color/mf_white"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lblErroPlayer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text=""
            android:textColor="@color/mf_white"
            android:textSize="17sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnTentarNovamente"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:background="@drawable/bg_pill_primary"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:paddingStart="30dp"
                android:paddingEnd="30dp"
                android:text="TENTAR DE NOVO"
                android:textColor="@color/mf_white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnSairErro"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginStart="14dp"
                android:background="@drawable/bg_pill_secondary"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:paddingStart="30dp"
                android:paddingEnd="30dp"
                android:text="VOLTAR"
                android:textColor="@color/mf_white"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bloqueio por assinatura / limite de telas -->
    <LinearLayout
        android:id="@+id/layoutBloqueio"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/mf_black"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="48dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge"
            android:gravity="center"
            android:paddingStart="26dp"
            android:paddingTop="10dp"
            android:paddingEnd="26dp"
            android:paddingBottom="10dp"
            android:text="Assinatura necessária"
            android:textColor="@color/mf_white"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lblBloqueio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text=""
            android:textColor="@color/mf_white"
            android:textSize="17sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnVerPlanos"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:background="@drawable/bg_pill_primary"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:paddingStart="30dp"
                android:paddingEnd="30dp"
                android:text="VER PLANOS"
                android:textColor="@color/mf_white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnSairBloqueio"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginStart="14dp"
                android:background="@drawable/bg_pill_secondary"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:paddingStart="30dp"
                android:paddingEnd="30dp"
                android:text="VOLTAR"
                android:textColor="@color/mf_white"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
