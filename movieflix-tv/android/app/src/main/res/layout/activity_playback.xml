<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mf_black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/progresso"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="center" />

    <LinearLayout
        android:id="@+id/layoutBloqueio"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/mf_black"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="48dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/mf_gradient"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingTop="10dp"
            android:paddingEnd="24dp"
            android:paddingBottom="10dp"
            android:text="Assinatura necessária"
            android:textColor="@color/mf_white"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lblErroPlayer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text=""
            android:textColor="@color/mf_white"
            android:textSize="17sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnAssinar"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:backgroundTint="@color/mf_pink"
                android:paddingStart="26dp"
                android:paddingEnd="26dp"
                android:text="ASSINAR (site/app)"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSair"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginStart="14dp"
                android:backgroundTint="@color/mf_indigo"
                android:paddingStart="26dp"
                android:paddingEnd="26dp"
                android:text="VOLTAR"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="3 planos disponíveis: Básico (HD), Padrão (Full HD), Premium (4K)"
            android:textColor="@color/mf_gray"
            android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>
