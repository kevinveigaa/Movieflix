<?xml version="1.0" encoding="utf-8"?>
<!--
  Layout do MovieFlix TV: APENAS o WebView da experiência de TV.

  O site cuida da interface; aqui só existe a superfície que o exibe. Não há
  splash nativo nem telas de erro próprias — o app abre direto na Home do TV e
  o próprio site já mostra o splash da marca e os estados de carregamento.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <WebView
        android:id="@+id/webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true"
        android:focusableInTouchMode="true" />

</FrameLayout>
