<?xml version="1.0" encoding="utf-8"?>
<!--
  Estrutura base das telas do MovieFlix TV:
  menu lateral persistente + divisor sutil + área de conteúdo.
  O conteúdo de cada tela é inflado dentro de @id/content_frame.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mf_black"
    android:orientation="horizontal">

    <com.movieflix.tv.SidebarView
        android:id="@+id/sidebar"
        android:layout_width="@dimen/sidebar_width"
        android:layout_height="match_parent" />

    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:alpha="0.3"
        android:background="@color/mf_border" />

    <FrameLayout
        android:id="@+id/content_frame"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@color/mf_black" />
</LinearLayout>
