<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mf_black"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="48dp">

    <ImageView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:contentDescription="MovieFlix"
        android:src="@drawable/mf_logo" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:letterSpacing="0.18"
        android:text="MOVIEFLIX"
        android:textColor="@color/mf_white"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/lblSub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Entre com a mesma conta do site"
        android:textColor="@color/mf_gray"
        android:textSize="16sp" />

    <EditText
        android:id="@+id/inputEmail"
        android:layout_width="420dp"
        android:layout_height="54dp"
        android:layout_marginTop="26dp"
        android:background="@drawable/bg_focus"
        android:hint="E-mail"
        android:importantForAutofill="no"
        android:inputType="textEmailAddress"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:textColor="@color/mf_white"
        android:textColorHint="@color/mf_gray"
        android:textSize="17sp" />

    <EditText
        android:id="@+id/inputSenha"
        android:layout_width="420dp"
        android:layout_height="54dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_focus"
        android:hint="Senha"
        android:importantForAutofill="no"
        android:inputType="textPassword"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:textColor="@color/mf_white"
        android:textColorHint="@color/mf_gray"
        android:textSize="17sp" />

    <Button
        android:id="@+id/btnEntrar"
        android:layout_width="420dp"
        android:layout_height="58dp"
        android:layout_marginTop="22dp"
        android:backgroundTint="@color/mf_red"
        android:text="ENTRAR"
        android:textColor="@color/mf_white"
        android:textSize="18sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnCriarConta"
        android:layout_width="420dp"
        android:layout_height="58dp"
        android:layout_marginTop="10dp"
        android:backgroundTint="@color/mf_purple"
        android:text="CRIAR CONTA"
        android:textColor="@color/mf_white"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/lblErro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text=""
        android:textColor="#F87171"
        android:textSize="15sp"
        android:visibility="gone" />
</LinearLayout>