<?xml version="1.0" encoding="utf-8"?>
<!--
  Login / Cadastro na identidade visual nova (fundo preto premium, acentos
  violeta→índigo, tipografia grande). Ordem de foco fixa e determinística
  para o controle remoto: e-mail → senha → ENTRAR → CRIAR CONTA.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mf_black">

    <!-- Brilho decorativo de marca no canto superior direito -->
    <View
        android:layout_width="620dp"
        android:layout_height="620dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-260dp"
        android:layout_marginEnd="-180dp"
        android:alpha="0.30"
        android:background="@drawable/mf_gradient" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="48dp">

        <ImageView
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:contentDescription="MovieFlix"
            android:src="@drawable/mf_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/bebas_neue"
            android:letterSpacing="0.14"
            android:text="MOVIEFLIX"
            android:textColor="@color/mf_white"
            android:textSize="40sp" />

        <TextView
            android:id="@+id/lblSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Entre com a mesma conta do site e do celular"
            android:textColor="@color/mf_gray"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="480dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:background="@drawable/bg_input"
            android:orientation="vertical">

            <EditText
                android:id="@+id/inputEmail"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:background="@null"
                android:hint="E-mail"
                android:importantForAutofill="no"
                android:inputType="textEmailAddress"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:textColor="@color/mf_white"
                android:textColorHint="@color/mf_gray"
                android:textSize="17sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="480dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_input"
            android:orientation="vertical">

            <EditText
                android:id="@+id/inputSenha"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:background="@null"
                android:hint="Senha"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:textColor="@color/mf_white"
                android:textColorHint="@color/mf_gray"
                android:textSize="17sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="480dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnEntrar"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_primary"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:text="ENTRAR"
                android:textColor="@color/mf_white"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnCriarConta"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_secondary"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:text="CRIAR CONTA"
                android:textColor="@color/mf_white"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/lblErro"
            android:layout_width="480dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text=""
            android:textColor="@color/mf_error"
            android:textSize="15sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
