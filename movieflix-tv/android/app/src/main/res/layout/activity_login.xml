<?xml version="1.0" encoding="utf-8"?>
<!--
  Login / Cadastro — MovieFlix TV.

  CORREÇÃO DO BUG "não consigo digitar a senha" (v2.0.1):
  a versão anterior empilhava tudo numa coluna vertical centralizada. Em telas
  16:9 de TV Box (altura útil ~540dp) o conteúdo passava de 540dp, e o campo de
  SENHA e o botão ENTRAR ficavam FORA DA TELA — sem rolagem e sem como alcançar
  pelo D-pad. O usuário via só o e-mail, exatamente como no print do problema.

  Agora a tela é:
    ESQUERDA  = formulário (marca, e-mail, senha, ENTRAR)
    DIREITA   = teclado em tela navegável pelo controle remoto (MfKeyboard)
  e o conjunto todo é envolvido por um ScrollView, de modo que em nenhuma
  resolução o botão ENTRAR fica inalcançável.

  Ordem de foco determinística para o D-pad:
    e-mail → senha → teclado (OK abre) → ENTRAR → CRIAR CONTA

  FLUXO DE PREENCHIMENTO (pedido do dono):
    OK no E-MAIL → o teclado sobe já escrevendo no e-mail;
    ENTER        → desce para a SENHA, SEM fechar o teclado;
    ENTER        → vai para o botão ENTRAR (teclado recolhe);
    OK em ENTRAR → autentica.

  O campo em edição fica destacado com bg_input_active, porque o foco do D-pad
  vive nas TECLAS do teclado — sem esse destaque não se saberia onde se digita.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mf_black">

    <!-- Brilho decorativo de marca no canto superior direito -->
    <View
        android:layout_width="560dp"
        android:layout_height="560dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-240dp"
        android:layout_marginEnd="-160dp"
        android:alpha="0.28"
        android:background="@drawable/mf_gradient" />

    <ScrollView
        android:id="@+id/scrollLogin"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingStart="28dp"
        android:paddingTop="20dp"
        android:paddingEnd="28dp"
        android:paddingBottom="20dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:weightSum="100">

            <!-- ══════════ COLUNA ESQUERDA — FORMULÁRIO ══════════ -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="52"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingEnd="24dp">

                <ImageView
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:contentDescription="MovieFlix"
                    android:src="@drawable/mf_logo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/bebas_neue"
                    android:letterSpacing="0.14"
                    android:text="MOVIEFLIX"
                    android:textColor="@color/mf_white"
                    android:textSize="34sp" />

                <TextView
                    android:id="@+id/lblSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Entre com a mesma conta do site e do celular"
                    android:textColor="@color/mf_gray"
                    android:textSize="14sp" />

                <!-- E-mail -->
                <EditText
                    android:id="@+id/inputEmail"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_input"
                    android:hint="E-mail"
                    android:importantForAutofill="no"
                    android:inputType="textEmailAddress"
                    android:nextFocusDown="@id/tecla0"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:textColor="@color/mf_white"
                    android:textColorHint="@color/mf_gray"
                    android:textSize="17sp" />

                <!-- Senha -->
                <EditText
                    android:id="@+id/inputSenha"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_input"
                    android:hint="Senha"
                    android:importantForAutofill="no"
                    android:inputType="textPassword"
                    android:nextFocusDown="@id/tecla0"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:textColor="@color/mf_white"
                    android:textColorHint="@color/mf_gray"
                    android:textSize="17sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Digite com as setas + OK. ENTER desce para a senha; ENTER de novo leva ao botão ENTRAR."
                    android:textColor="@color/mf_gray"
                    android:textSize="12sp" />

                <!-- Ações -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnEntrar"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_pill_primary"
                        android:clickable="true"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:gravity="center"
                        android:nextFocusUp="@id/tecla0"
                        android:text="ENTRAR"
                        android:textColor="@color/mf_white"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnCriarConta"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_pill_secondary"
                        android:clickable="true"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:gravity="center"
                        android:text="CRIAR CONTA"
                        android:textColor="@color/mf_white"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Recuperar senha (mesmo fluxo Supabase do site/app) -->
                <TextView
                    android:id="@+id/btnEsqueciSenha"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_pill_ghost"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="ESQUECI A SENHA"
                    android:textColor="@color/mf_gray_light"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/lblErro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="start"
                    android:text=""
                    android:textColor="@color/mf_error"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/lblSucesso"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="start"
                    android:text=""
                    android:textColor="@color/mf_green_light"
                    android:textSize="14sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- ══════════ COLUNA DIREITA — TECLADO EM TELA ══════════ -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="48"
                android:background="@drawable/bg_login_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="10dp"
                    android:text="TECLADO DO CONTROLE"
                    android:textColor="@color/mf_purple_light"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <com.movieflix.tv.MfKeyboard
                    android:id="@+id/teclado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
