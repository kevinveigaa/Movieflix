<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mf_black"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="48dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/mf_gradient"
        android:gravity="center"
        android:paddingStart="32dp"
        android:paddingTop="14dp"
        android:paddingEnd="32dp"
        android:paddingBottom="14dp"
        android:text="MovieFlix TV"
        android:textColor="@color/mf_white"
        android:textSize="38sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/lblSub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Entre com a mesma conta do site"
        android:textColor="@color/mf_gray"
        android:textSize="16sp" />

    <EditText
        android:id="@+id/inputEmail"
        android:layout_width="400dp"
        android:layout_height="52dp"
        android:layout_marginTop="28dp"
        android:background="@drawable/bg_focus"
        android:hint="E-mail"
        android:importantForAutofill="no"
        android:inputType="textEmailAddress"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@color/mf_white"
        android:textColorHint="@color/mf_gray"
        android:textSize="17sp" />

    <EditText
        android:id="@+id/inputSenha"
        android:layout_width="400dp"
        android:layout_height="52dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_focus"
        android:hint="Senha"
        android:importantForAutofill="no"
        android:inputType="textPassword"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@color/mf_white"
        android:textColorHint="@color/mf_gray"
        android:textSize="17sp" />

    <Button
        android:id="@+id/btnEntrar"
        android:layout_width="400dp"
        android:layout_height="56dp"
        android:layout_marginTop="22dp"
        android:backgroundTint="@color/mf_pink"
        android:text="ENTRAR"
        android:textSize="18sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnCriarConta"
        android:layout_width="400dp"
        android:layout_height="56dp"
        android:layout_marginTop="10dp"
        android:backgroundTint="@color/mf_indigo"
        android:text="CRIAR CONTA"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/lblErro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text=""
        android:textColor="#F87171"
        android:textSize="15sp"
        android:visibility="gone" />
</LinearLayout>
