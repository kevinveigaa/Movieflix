<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mf_black"
    android:orientation="vertical"
    android:padding="48dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Continuar assistindo"
        android:textColor="@color/mf_white"
        android:textSize="34sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/lblHistoricoVazio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text=""
        android:textColor="@color/mf_gray"
        android:textSize="16sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/listaHistorico"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="18dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnLimparHistorico"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:backgroundTint="@color/mf_surface_strong"
            android:paddingStart="26dp"
            android:paddingEnd="26dp"
            android:text="LIMPAR HISTÓRICO"
            android:textColor="@color/mf_white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnVoltarHistorico"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_marginStart="14dp"
            android:backgroundTint="@color/mf_purple"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:text="VOLTAR"
            android:textColor="@color/mf_white"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
