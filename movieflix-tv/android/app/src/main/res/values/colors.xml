<?xml version="1.0" encoding="utf-8"?>
<!-- Identidade visual MovieFlix TV — MESMA paleta do MovieFlix Mobile/site.
     Fundo preto premium (ink-950 #050505 + #0A0A0F), acento violeta
     (roxo-600 #7C3AED / roxo-400 #A78BFA) e a MARCA MovieFlix (brand #DF0A15).
     Os nomes dos tokens sao os mesmos do tailwind.config.js do site. -->
<resources>
    <!-- Superficies (ink-950 / #0A0A0F / ink-800 / roxo escuro) -->
    <color name="mf_black">#050505</color>
    <color name="mf_surface">#0A0A0F</color>
    <color name="mf_surface_light">#171717</color>
    <color name="mf_surface_strong">#241B33</color>

    <!-- Acento primario (roxo-600 / roxo-400 / indigo) -->
    <color name="mf_purple">#7C3AED</color>
    <color name="mf_purple_light">#A78BFA</color>
    <color name="mf_indigo">#5B42F3</color>

    <!-- MARCA MovieFlix (brand-600 do site) + secundario (magenta) -->
    <color name="mf_red">#DF0A15</color>
    <color name="mf_magenta">#E01E5A</color>

    <!-- Texto -->
    <color name="mf_white">#FFFFFF</color>
    <color name="mf_gray">#A3A3A3</color>
    <color name="mf_gray_light">#D4D4D8</color>
    <color name="mf_border">#3A3A44</color>

    <!-- Selo Dublado PT-BR / nota / erro -->
    <color name="mf_green">#00A896</color>
    <color name="mf_gold">#FBBF24</color>
    <color name="mf_error">#F87171</color>

    <!-- Scrims / overlays -->
    <color name="mf_scrim_bottom">#E6050505</color>
    <color name="mf_scrim_mid">#99050505</color>
    <color name="mf_overlay_card">#CC05050A</color>
    <color name="mf_transparent">#00000000</color>
</resources>
