<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MovieFlixTV" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/mf_purple</item>
        <item name="colorPrimaryDark">@color/mf_black</item>
        <item name="colorAccent">@color/mf_red</item>
        <item name="android:windowBackground">@color/mf_black</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">@color/mf_red</item>
        <item name="android:colorPrimary">@color/mf_purple</item>
        <item name="android:colorPrimaryDark">@color/mf_black</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="Theme.MovieFlixTV.Splash" parent="Theme.MovieFlixTV">
        <item name="android:windowBackground">@color/splash_background</item>
    </style>

    <!-- Título display (Bebas Neue) — usado no wordmark MOVIEFLIX e títulos hero -->
    <style name="TextAppearance.MovieFlix.Display" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">@font/bebas_neue</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/mf_white</item>
        <item name="android:letterSpacing">0.04</item>
    </style>
</resources>