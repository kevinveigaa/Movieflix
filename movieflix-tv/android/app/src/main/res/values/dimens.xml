<?xml version="1.0" encoding="utf-8"?>
<!-- Metricas da interface de TV (16:9). Tudo em dp/sp: escala sozinho em
     720p / 1080p / 4K, porque o Android converte dp para a densidade real.

     Cards: ~6 por linha em uma TV 1080p tipica. O numero REAL de colunas e
     calculado em CatalogoJanela.colunas() a partir da largura em PIXELS da
     tela — nao existe constante fixa de 6. -->
<resources>
    <dimen name="content_pad">32dp</dimen>
    <dimen name="content_pad_top">18dp</dimen>

    <!-- Cabecalho: logo MovieFlix + navegacao com estado ativo -->
    <dimen name="header_height">60dp</dimen>
    <dimen name="header_logo_width">124dp</dimen>
    <dimen name="header_logo_height">36dp</dimen>
    <dimen name="header_mark">34dp</dimen>
    <dimen name="tab_pad_h">18dp</dimen>
    <dimen name="tab_pad_v">11dp</dimen>

    <!-- HERO (banner de destaque) -->
    <dimen name="hero_height">258dp</dimen>
    <dimen name="hero_pad">40dp</dimen>
    <dimen name="hero_title">34sp</dimen>
    <dimen name="hero_desc">14sp</dimen>
    <dimen name="hero_btn_height">46dp</dimen>

    <!-- Cards (poster 2:3) — menores e melhor distribuidos que antes -->
    <dimen name="card_width">132dp</dimen>
    <dimen name="card_height">198dp</dimen>
    <dimen name="card_gutter">14dp</dimen>
    <dimen name="card_radius">10dp</dimen>
    <dimen name="row_title">17sp</dimen>
    <dimen name="row_spacing">22dp</dimen>

    <!-- Grid -->
    <dimen name="grid_pad">32dp</dimen>
    <dimen name="focus_ring">3dp</dimen>

    <!-- Legado (compat. com telas que ainda usam estes nomes) -->
    <dimen name="topbar_height">60dp</dimen>
    <dimen name="topbar_item_height">40dp</dimen>
    <dimen name="sidebar_width">200dp</dimen>
    <dimen name="sidebar_item_height">42dp</dimen>
</resources>
